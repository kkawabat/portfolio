# Multi-stage build for better optimization
FROM python:3.11-slim AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV POETRY_VERSION=1.7.1
ENV POETRY_HOME="/opt/poetry"
ENV POETRY_VENV="/opt/poetry/venv"
ENV POETRY_CACHE_DIR='/var/cache/pypoetry'
ENV PIP_TIMEOUT=300
ENV PIP_RETRIES=3

# Force CPU-only versions of ML libraries
ENV TORCH_CUDA_ARCH_LIST=""
ENV FORCE_CUDA="0"
ENV CUDA_VISIBLE_DEVICES=""

# Add Poetry to PATH
ENV PATH="$POETRY_VENV/bin:$PATH"

# Install system dependencies needed for building
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    curl \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 -

# Set work directory
WORKDIR /app

# Copy only dependency files first (better layer caching)
COPY pyproject.toml poetry.lock ./

# Configure Poetry to not create virtual environment
RUN poetry config virtualenvs.create false

# Install CPU-only versions of heavy packages first
RUN pip install --no-cache-dir \
    torch==2.3.1+cpu -f https://download.pytorch.org/whl/torch_stable.html \
    torchvision==0.18.1+cpu -f https://download.pytorch.org/whl/torch_stable.html \
    torchaudio==2.3.1+cpu -f https://download.pytorch.org/whl/torch_stable.html

# Install Python dependencies only (excluding torch which we installed above)
RUN poetry config installer.max-workers 1 && \
    poetry install --only main --no-interaction --no-ansi --no-root --no-cache

# Production stage
FROM python:3.11-slim AS production

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV POETRY_VERSION=1.7.1
ENV POETRY_HOME="/opt/poetry"
ENV POETRY_VENV="/opt/poetry/venv"
ENV POETRY_CACHE_DIR='/var/cache/pypoetry'
ENV PIP_TIMEOUT=300
ENV PIP_RETRIES=3

# Force CPU-only versions
ENV TORCH_CUDA_ARCH_LIST=""
ENV FORCE_CUDA="0"
ENV CUDA_VISIBLE_DEVICES=""

# Add Poetry to PATH
ENV PATH="$POETRY_VENV/bin:$PATH"

# Install only runtime system dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    git \
    ffmpeg \
    portaudio19-dev \
    python3-pyaudio \
    nodejs \
    npm \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Poetry (runtime version)
RUN curl -sSL https://install.python-poetry.org | python3 -

# Set work directory
WORKDIR /app

# Copy Poetry configuration and dependencies from builder
COPY --from=builder /opt/poetry /opt/poetry
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy project files
COPY . .

# Configure Poetry
RUN poetry config virtualenvs.create false

# Install the project itself (if needed)
RUN poetry install --only main --no-interaction --no-ansi

# Clean up unnecessary files to reduce image size
RUN find /usr/local/lib/python3.11/site-packages -name "*.pyc" -delete && \
    find /usr/local/lib/python3.11/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11/site-packages -name "tests" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11/site-packages -name "test" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11/site-packages -name "*.so" -exec strip {} \; 2>/dev/null || true

# Remove NVIDIA/CUDA related packages if they exist
RUN find /usr/local/lib/python3.11/site-packages -name "*nvidia*" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11/site-packages -name "*cuda*" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11/site-packages -name "*triton*" -type d -exec rm -rf {} + 2>/dev/null || true

# Collect static files
RUN poetry run python manage.py collectstatic --noinput

# Create a non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Run the application
CMD ["poetry", "run", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "portfolio.wsgi:application"] 