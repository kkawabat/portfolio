# Global options
{
    # Email for Let's Encrypt (required for automatic HTTPS)
    email {$CADDY_EMAIL:admin@example.com}
    
    # Auto HTTPS settings
    auto_https {$AUTO_HTTPS:on}
    
    # Log level
    log {
        level {$LOG_LEVEL:INFO}
    }
    
    # Admin API (disable in production for security)
    admin {$ADMIN_API:off}
}
