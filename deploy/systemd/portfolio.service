[Unit]
Description=Portfolio Django Application
After=network.target
Wants=network.target

[Service]
Type=notify
User=www-data
Group=www-data
RuntimeDirectory=portfolio
WorkingDirectory=/app
Environment=DJANGO_SETTINGS_MODULE=portfolio.settings
Environment=PYTHONPATH=/app
ExecStart=/usr/local/bin/poetry run gunicorn --config /app/deploy/gunicorn.conf.py portfolio.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app /var/log/gunicorn /var/run/gunicorn

[Install]
WantedBy=multi-user.target 